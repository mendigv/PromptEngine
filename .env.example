# URL del database PostgreSQL (ad esempio Supabase)
DATABASE_URL="postgresql://user:password@host:port/database"

# Chiavi API per i modelli (configurabili per il BYOK)
GROQ_API_KEY="gsk_tua_chiave_api_qui"
OPENAI_API_KEY="sk-tua_chiave_api_qui"
ANTHROPIC_API_KEY="sk-ant-tua_chiave_api_qui"
DEEPSEEK_API_KEY="sk-tua_chiave_api_qui"
GOOGLE_API_KEY="AIza_tua_chiave_api_qui"

# Segreti per la generazione dei token JWT
JWT_SECRET="inserisci_qui_una_stringa_casuale_lunga_per_la_sicurezza"
JWT_REFRESH_SECRET="inserisci_qui_un_altra_stringa_casuale_lunga"
